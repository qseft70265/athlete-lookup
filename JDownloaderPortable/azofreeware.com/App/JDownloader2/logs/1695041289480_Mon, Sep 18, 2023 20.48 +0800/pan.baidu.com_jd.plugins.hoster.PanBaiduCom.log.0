<div node-type="module" class="module-share-person-info true">
    <div class="share-person-inner global-clearfix haha">
        <div class="share-person-avatar theme-share-page-head">
            
                <a href="//yun.baidu.com/buy/center?tag=1&from=sicon" class="svip-icon sicon"><em></em></a>
            
            <a href="javascript:void(0)" title="去Ta的分享主页" class="person-icon">
                <img class="theme-share-page-head" alt="an**na" src="https://himg.bdimg.com/sys/portrait/item/public.1.8a1a0207.lNHtSF3FESeNuJbzwQpVSA.jpg">
                <span class="cert-info"></span>
            </a>
        </div>
        <div class="share-person-data self">
            <div class="share-person-data-top">
                <a href="javascript:;" class="share-person-username global-ellipsis theme-share-page-name">
                    an**na
                </a>
                
                <a href="//yun.baidu.com/buy/center?tag=8&from=sicon" class="svip-icon sicon"><em></em></a>
                
