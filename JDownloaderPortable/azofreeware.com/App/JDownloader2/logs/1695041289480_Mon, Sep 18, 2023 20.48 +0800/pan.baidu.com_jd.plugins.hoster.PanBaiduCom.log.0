                <a href="//yun.baidu.com/buy/center?tag=1&from=sicon" class="svip-icon sicon"><em></em></a>
            
            <a href="javascript:void(0)" title="去Ta的分享主页" class="person-icon">
                <img class="theme-share-page-head" alt="an**na" src="https://himg.bdimg.com/sys/portrait/item/public.1.8a1a0207.lNHtSF3FESeNuJbzwQpVSA.jpg">
                <span class="cert-info"></span>
            </a>
        </div>
        <div class="share-person-data self">
            <div class="share-person-data-top">
                <a href="javascript:;" class="share-person-username global-ellipsis theme-share-page-name">
                    an**na
                </a>
                
                <a href="//yun.baidu.com/buy/center?tag=8&from=sicon" class="svip-icon sicon"><em></em></a>
                
            </div>
        </div>
         
        <div class="author-desc">
            <div class="author-intro theme-share-page-name">暂无签名</div>
        </div>
        <div class="enterprise-info">
            <span class="from-info"></span>
        </div>
        <div class="enterprise-memo">
            <span class="memo-info"></span>
        </div>
        <div class="enterprise-follow">
            <div class="btn follow" role="button">关注</div>
            <div class="btn go-im" role="button">
                <a class="" role="button" target="_blank" href="" title="发消息">
                    发消息
                </a>
            </div>
            <div class="text not-open-im">该企业未开通企业号</div>
        </div>
        <div class="enterprise-card">
            <!-- 企业名片 -->
            <div class="ent-card ent-card-detail">
                <div class="e-row phone">
                    <div class="left">
                      <i class="icon phone"></i>
                      <input class="value ent-phone-value" value="" disabled />
                    </div>
                    <div class="btn ent-phone-copy" role="button">复制</div>
                </div>
                <div class="e-row email">
                    <div class="left">
                      <i class="icon email"></i>
                      <input class="value ent-email-value" value="" disabled />
                    </div>
                    <div class="btn ent-email-copy" role="button">复制</div>
                </div>
                <div class="e-row address">
                    <div class="left">
                      <i class="icon address"></i>
                      <input class="value ent-address-value" value="" disabled />
                    </div>
                    <div class="btn ent-address-copy" role="button">复制</div>
                </div>
            </div>
            <!-- 员工名片 -->
            <div class="staff-card staff-card-detail">
                <div class="e-row phone">
                    <div class="left">
                      <i class="icon phone"></i>
                      <input class="value staff-phone-value" value="" disabled />
                    </div>
                    <div class="btn staff-phone-copy" role="button">复制</div>
                </div>
                <div class="e-row wechat">
                    <div class="left">
                      <i class="icon wechat"></i>
                      <input class="value staff-wechat-value" value="" disabled />
                    </div>
                    <div class="btn staff-wechat-copy" role="button">复制</div>
                </div>
                <div class="e-row email">
                    <div class="left">
                      <i class="icon email"></i>
                      <input class="value staff-email-value" value="" disabled />
                    </div>
                    <div class="btn staff-email-copy" role="button">复制</div>
                </div>
            </div>
        </div>
        <div class="share-person-certinfo">
            <a target="_blank" href="https://pan.baidu.com/disk/cert/#/web/home?from=sharelist" title="了解企业认证">
                <span>了解企业认证</span>
            </a>
        </div>
        
        
        
            <div class="verify-friend theme-share-page-name-hover">加为好友</div>
        
    </div>
    <ul class="share-person-numbers" node-type="share-person-numbers">
        <li class="sharecnt">
            <a href="/share/home?uk=0&suk=&view=share">
                <em title="<%= data.pubshare_count %>"><%= data.pubshare_count %></em><span>分享</span>
            </a>
        </li>
        <li class="albumcnt">
            <a href="/share/home?uk=0&suk=&view=album">
                <em title="<%= data.album_count %>"><%= data.album_count %></em><span>专辑</span>
            </a>
        </li>
        <li class="fanscnt">
            <a href="/share/home?uk=0&suk=&view=fans">
                <em title="<%= data.fans_count %>"><%= data.fans_count %></em><span>粉丝</span>
            </a>
        </li>
    </ul>
</div>
