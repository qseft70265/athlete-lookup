        <div class="slide-show-left">
            <h2 class="file-name" title="文件名">
                <em class="global-icon-16"></em> 文件名
            </h2>
        </div>
        <div class="slide-show-center">
            <div class="subscribe-btn">订阅链接</div>
            <div class="subscribe-tips">订阅后链接内容更新时您将收到实时通知</div>
        </div>
        <div class="slide-show-right">
            <span class="slide-header-funcs">
            </span>
            <div class="module-share-top-bar g-clearfix">
                <div class="bar"></div>
            </div>
        </div>
        <div class="cb"></div>
        <div class="slide-show-other-infos">
            <div class="share-file-info">
                <span>2023-05-23 22:53</span>
            </div>
            
                
                    <div class="share-valid-check">过期时间：永久有效</div>
                
            
            <div class="cert-user-share-list">来自企业的分享</div>
            <div class="cert-user-share-bind-info">
                <span class="cert-user-share-bind-info-head"></span>
                <span class="cert-user-share-bind-info-tail">已失效</span>
            </div>
            <div class="verify-user-protect-share-list icon icon-share-lock" style="display: none">
                <span class="verify-user-protect-share-list-text">密享</span>
            </div>
            

            <div class="slide-show-other-cns clearfix">
              <span class="title-funcs">
                  
                   <span class="funcs-share-area">
                   </span>
              </span>
            </div>

            <div class="cb"></div>

        </div>
    </div>
</div>

                
